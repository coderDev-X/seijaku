# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/frontend/node_modules
/backend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/frontend/.next/
/out/
/frontend/out/

# production
/build
/backend/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
/frontend/.env*
!/frontend/.env.example
/backend/.env*
!/backend/.env.example

# vercel
.vercel
/frontend/.vercel
/backend/.vercel

# typescript
*.tsbuildinfo

# tooling
.vscode

downloaded_images

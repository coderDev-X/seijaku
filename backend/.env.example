PORT=4001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seijaku_backend?schema=public"
JWT_SECRET="change-me"
ADMIN_EMAIL="admin@seijaku.local"
ADMIN_PASSWORD="password123"

# Notify Me admin-ping (all optional; stubbed until a provider is wired).
# When blank the notifier silently skips dispatch; the ProductNotification
# row is still persisted and will surface in /admin/leads.
# ADMIN_NOTIFICATION_EMAIL="ops@seijaku.co"
# NOTIFIER_FROM_EMAIL="notifications@seijaku.co"
# RESEND_API_KEY=""

# Razorpay (required — backend refuses to start without these).
# For local dev that doesn't exercise payments, any non-empty placeholder
# works for KEY_ID / KEY_SECRET / WEBHOOK_SECRET; just don't run a real
# transaction with placeholder values.
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Shiprocket (required — backend refuses to start without these).
# Shiprocket has no API-key auth; email + password are exchanged for a
# ~10-day JWT, cached in src/lib/shiprocket.ts. Use a dedicated service
# account if you can. Pickup-location name + default dimensions + the
# auto-push toggle are admin-editable via /admin/shipping (DB-backed,
# not env-driven) so admins can change them without a redeploy.
SHIPROCKET_EMAIL="ops@seijaku.local"
SHIPROCKET_PASSWORD="placeholder_password"
SHIPROCKET_WEBHOOK_SECRET="placeholder_webhook_secret"

ABANDON_AFTER_HOURS=2

# Brevo (formerly Sendinblue) (required — backend refuses to start without this).
BREVO_API_KEY="placeholder_api_key"

# Template IDs (grab each from /templates/email/edit/<id>)
BREVO_TPL_ORDER_CONFIRMATION=3
BREVO_TPL_PAYMENT_SUCCESS=4
BREVO_TPL_PAYMENT_FAILED=5
BREVO_TPL_SHIPMENT_UPDATE=6
BREVO_TPL_ABANDONED_CART=7
